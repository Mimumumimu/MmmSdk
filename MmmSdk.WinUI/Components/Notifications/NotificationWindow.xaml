<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmSdk.WinUI.Components.Notifications.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="通知">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- 背景を透明にしないと、何も描いていない余白が当たり判定を持たず、クリックが届かない -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <!-- 到達の明滅：不透明度 0 → 0.55 (0.09 秒)→ 0 (0.18 秒)を 3 回 -->
            <Storyboard x:Name="BlinkStoryboard" RepeatBehavior="3x">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlinkOverlay" Storyboard.TargetProperty="Opacity">
                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.09" Value="0.55" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.27" Value="0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Grid.Resources>

        <!-- 上の余白は、右上のウィンドウボタンと、節の見出しが重ならないための空き。左に、ウィンドウ全体の名前を置く。節の見出しと項目は、コードで組み立てる -->
        <Grid Padding="16,8,16,16">
            <TextBlock
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="通知" />
            <ScrollViewer Margin="0,28,0,0" VerticalScrollBarVisibility="Visible">
                <StackPanel x:Name="BodyPanel" Spacing="14" />
            </ScrollViewer>
        </Grid>

        <!-- 到達時の明滅用。操作を邪魔しないよう当たり判定を持たせない。既定は透明 -->
        <Border
            x:Name="BlinkOverlay"
            Background="#FFFFB300"
            IsHitTestVisible="False"
            Opacity="0" />
    </Grid>
</Window>
