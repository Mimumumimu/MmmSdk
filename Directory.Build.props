<Project>
  <!-- SDK の全プロジェクト共通の設定。プロジェクト固有の設定 (対象フレームワーク・WinUI 等)は各 csproj に書く -->
  <PropertyGroup>
    <!-- SDK のバージョン (major.minor.patch。アプリとは別に上げる)。ファイル・アセンブリのバージョンはここから自動で 4 桁 (0.1.0.0)になる -->
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML ドキュメントコメントの検査 (書き漏れ・参照切れを警告にする)。未使用 using の検査 (IDE0005)にも必要 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- .editorconfig のコードスタイルをビルド時にも検査する -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      全プロジェクトを x64 専用にする (Core も含めて AnyCPU を使わない)。
      Platforms は VS で選べる一覧なので、既定の Platform も x64 にする (-p:Platform を付けないビルドで AnyCPU にならないように。CsWin32 は AnyCPU では一部の API を作れない)
    -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <!-- プラットフォームは x64 だけなので、出力先 (bin・obj)に x64 の段を作らない (bin\<構成>\<TFM>\) -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <!--
      RID も win-x64 だけなので、出力先に RID の段を作らない。
      参照するアプリの発行 (VS の「発行」)は RID を参照先にも渡すので、段を作ると、RID の有無で出力先が変わり、先にビルドした DLL を見つけられずに失敗する
    -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
</Project>
